{
  "name": "tollpike",
  "version": "0.1.0",
  "description": "Routing infrastructure for AI. One OpenAI-compatible endpoint across 46 providers, with cost caps, 3-layer resilience, caching and guardrails.",
  "author": "IQGlitching",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tollpike": "bin/tollpike.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "config/",
    "public/",
    "deploy/",
    "scripts/",
    ".env.example",
    "Dockerfile",
    "docker-compose.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f tollpike",
    "test": "node --test \"test/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/*.test.mjs\"",
    "verify": "node scripts/verify-providers.mjs",
    "verify-pricing": "node scripts/verify-pricing.mjs"
  },
  "keywords": [
    "ai",
    "llm",
    "gateway",
    "router",
    "openai-compatible",
    "proxy",
    "anthropic",
    "openai",
    "gemini",
    "mcp",
    "a2a",
    "observability",
    "cost-control",
    "rate-limiting",
    "circuit-breaker"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IQGlitching/Tollpike.git"
  },
  "homepage": "https://github.com/IQGlitching/Tollpike#readme",
  "bugs": {
    "url": "https://github.com/IQGlitching/Tollpike/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "undici": "^6.28.0"
  },
  "engines": {
    "node": ">=18"
  }
}
