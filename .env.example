# Copy this file to .env and fill in whichever providers you actually use.
# Nothing is required — tollpike boots with zero keys set, it just won't
# have anywhere to route requests until you add at least one.
#
# WHERE TO PUT REAL KEYS
#
# Not here. src/env.js resolves credentials like this:
#
#   $TOLLPIKE_ENV_FILE  if set, that file is the ONLY one read — naming a file
#                       suppresses both defaults below. This is what lets a
#                       container, a CI job or the test suite guarantee it sees
#                       no ambient credentials.
#
#   otherwise, two files layer, first match per variable winning:
#     1. ~/.tollpike/.env   the default home for real credentials
#     2. ./.env             this directory — loaded last
#
# A variable already set in the real environment beats every file, so
# `docker run -e` and systemd's EnvironmentFile keep working unchanged.
#
# Put API keys in ~/.tollpike/.env. It sits outside the project tree, which
# matters more than file permissions do: a .env inside the repo gets zipped,
# synced to cloud storage, copied into a bug report and committed by accident.
# Create it with inherited permissions stripped so only your account can read
# it — on Windows:
#
#   icacls "%USERPROFILE%\.tollpike" /inheritance:r
#   icacls "%USERPROFILE%\.tollpike" /grant:r "%USERNAME%:(OI)(CI)(F)"
#
# ...and on Linux/macOS: chmod 700 ~/.tollpike && chmod 600 ~/.tollpike/.env
#
# Keep the project .env for NON-SECRET local settings (PORT, BIND_HOST,
# timeouts) and for Docker Compose, which mounts it into the container.

PORT=20128

# Interface to bind. Defaults to loopback: the control panel API is
# unauthenticated until you set a gateway key, so it should not be on the
# network by accident. Set 0.0.0.0 only if you mean it — and set a gateway
# key first.
# BIND_HOST=127.0.0.1

# If you front the gateway with a hostname (reverse proxy, tailnet name),
# list it here. Requests carrying any other Host header are refused, which
# is what stops a DNS-rebinding page from driving the control panel.
# TOLLPIKE_ALLOWED_HOSTS=gateway.internal,tollpike.tailnet.ts.net

# Upstream request deadlines. Without these a provider that accepts the
# connection and then goes quiet holds the request open forever, and the
# fallback chain never gets a turn.
# UPSTREAM_TIMEOUT_MS=120000
# UPSTREAM_STALL_TIMEOUT_MS=90000

# Allows the API key to travel in the URL path for clients that cannot send
# a custom auth header:  POST /vscode/<key>/chat/completions
# OFF by default and worth keeping off: URLs leak through proxy logs,
# browser history and Referer headers in ways headers do not.
# ALLOW_PATH_TOKEN=false

# By default a request for "provider/model" is rejected unless the model is
# listed for that provider in config/providers.json — otherwise the models
# array is documentation rather than an allowlist, and spend gets billed at
# the wrong cost table.
# ALLOW_UNLISTED_MODELS=false

# Master secret for encrypting stored credentials at rest (AES-256-GCM).
# If unset, values are stored as honest plaintext rather than being
# fake-encrypted with a hardcoded key. Set this to something random and
# keep it somewhere safe — losing it means stored encrypted values can't
# be recovered.
#
# Belongs in ~/.tollpike/.env, not here. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TOLLPIKE_SECRET=

# Explicit path to the file holding your real credentials. Only needed if you
# do not want the default ~/.tollpike/.env — a mounted secret, a shared
# location, a second profile. A path that does not exist is warned about at
# startup rather than silently leaving every provider unconfigured.
# TOLLPIKE_ENV_FILE=/run/secrets/tollpike.env

# Any provider key accepts a COMMA-SEPARATED list. Each key becomes an
# independent "connection" that cools down separately, so one rejected or
# rate-limited key doesn't take the whole provider out of rotation:
#   GROQ_API_KEY=key_one,key_two,key_three

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# --- Inference providers -------------------------------------------------
PERPLEXITY_API_KEY=   # Perplexity — https://api.perplexity.ai
